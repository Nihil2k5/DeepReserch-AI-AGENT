# ---------------------------------------------------------------------------
# Deep Research Agent configuration. Every variable is prefixed with DR_.
# This service requires REAL INFRASTRUCTURE: Postgres, Redis, an LLM API and
# a web-search API. There is no offline mode for production runs.
# ---------------------------------------------------------------------------

# --- App ---
DR_ENVIRONMENT=development
DR_LOG_LEVEL=INFO
# If set, mutating routes require the X-API-Key header.
# DR_API_KEY=change-me

# --- Required infrastructure ---
DR_DATABASE_URL=postgresql://research:research@localhost:5432/research
DR_REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# DR_LLM_PROVIDER: openai (any OpenAI-compatible endpoint) | ollama (local) | fake (tests)
DR_LLM_PROVIDER=openai
# For DR_LLM_PROVIDER=openai:
DR_LLM_API_KEY=sk-...
DR_LLM_BASE_URL=https://api.openai.com/v1
DR_LLM_MODEL=gpt-4o-mini
DR_LLM_REASONING_MODEL=gpt-4o
DR_REQUEST_TIMEOUT=90
# For DR_LLM_PROVIDER=ollama (no API key needed, local models, zero cost):
#   ollama pull llama3.2:3b
#   DR_LLM_PROVIDER=ollama
#   DR_LLM_BASE_URL=http://localhost:11434/v1
#   DR_LLM_MODEL=llama3.2:3b
#   DR_LLM_REASONING_MODEL=llama3.2:3b

# --- Web search ---
# DR_SEARCH_PROVIDER: exa (semantic search API) | browser (headless Chrome scraping) | fake (tests)
# Get an Exa key at https://dashboard.exa.ai (free credits on signup)
DR_SEARCH_PROVIDER=exa
DR_EXA_API_KEY=...
DR_SEARCH_RESULTS=5
DR_MAX_SEARCH_CONCURRENCY=4
# For DR_SEARCH_PROVIDER=browser (no API key; scrapes DuckDuckGo with installed Chrome):
#   DR_SEARCH_PROVIDER=browser
#   DR_BROWSER_HEADLESS=true
#   DR_BROWSER_PAGE_TIMEOUT_S=15
#   DR_BROWSER_MAX_PAGE_CHARS=6000

# --- Run budgets (hard limits enforced mid-run) ---
DR_MAX_LLM_CALLS=60
DR_MAX_SEARCHES=40
DR_MAX_COST_USD=1.50
DR_MAX_WALL_CLOCK_S=900
DR_MAX_SUBQUESTIONS=4
DR_MAX_RESEARCH_ROUNDS=2

# --- Observability (optional but recommended) ---
# Self-host or use Langfuse Cloud: https://cloud.langfuse.com
# DR_LANGFUSE_PUBLIC_KEY=pk-lf-...
# DR_LANGFUSE_SECRET_KEY=sk-lf-...
DR_LANGFUSE_HOST=https://cloud.langfuse.com

# --- Worker ---
DR_WORKER_POLL_INTERVAL_S=2
DR_WORKER_CONCURRENCY=2
# DR_WORKER_ID=worker-1
